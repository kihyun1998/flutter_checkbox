{
  "map_dir": "docs/map",
  "path_roots": ["."],
  "source_globs": ["lib/**/*.dart", "test/*.dart", "example/lib/*.dart", "pubspec.yaml", ".pubignore"],
  "comment_globs": ["lib/**/*.dart"],
  "comment_exts": [".dart", ".yaml"],
  "cited_path_pattern": "((?:docs)/[A-Za-z0-9_./-]+\\.md)",
  "command_words": ["grep", "ls", "rg", "git", "flutter", "dart", "gh", "sed"],
  "kinds": {
    "territory": {"match": "territory/", "sections": ["## What it is", "## Governing decisions", "## Design model", "## Code", "## Reference behaviour", "## Cross-cutting invariants", "## Blast radius", "## Known holes / open"]},
    "invariant": {"match": "invariant/", "sections": ["## The fact", "## Why it is cross-cutting", "## Territories it holds in", "## What a violation looks like", "## Discovery history", "## Where it will recur"]}
  },
  "owned_value_patterns": [
    {"pattern": "(?:ADR|adr)[- ]?0?0?[0-9]{1,4}[^.\\n]{0,120}?\\b(?:is |still |remains )(?:proposed|accepted)\\b", "owner": "the decision record", "say_instead": "say \"check its Status line\""},
    {"pattern": "\\b[0-9]+ tests\\b", "owner": "flutter test", "say_instead": "run it"}
  ],
  "reciprocity": {
    "both_ways": false,
    "from": {"dir": "invariant", "section": "## Territories it holds in", "link_pattern": "\\(\\.\\./territory/([a-z0-9-]+\\.md)\\)"},
    "to": {"dir": "territory", "section": "## Cross-cutting invariants", "link_pattern": "\\(\\.\\./invariant/([a-z0-9-]+\\.md)\\)"}
  },
  "skip_dirs": [".git", "node_modules", "build", ".dart_tool", "android", "ios", "web", "linux", "macos", "windows"]
}
